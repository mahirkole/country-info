{
  "name": "country-info",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Countries and administrative regions as an API and versioned files, with snapshot/delta/webhook updates",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "migrate": "tsx src/cli.ts migrate",
    "ingest": "tsx src/cli.ts ingest",
    "ingest:gisco": "tsx src/cli.ts ingest-gisco",
    "ingest:holidays": "tsx src/cli.ts ingest-holidays",
    "link": "tsx src/cli.ts link",
    "enrich:wikidata": "tsx src/cli.ts enrich-wikidata",
    "refresh": "tsx src/cli.ts refresh",
    "check:sources": "tsx src/cli.ts refresh --dry-run",
    "check:licenses": "tsx src/cli.ts check-licenses",
    "license:ack": "tsx src/cli.ts license-ack",
    "ingest:national": "tsx src/cli.ts ingest-national",
    "check:holidays": "tsx src/cli.ts check-holidays",
    "export": "tsx src/cli.ts export",
    "publish": "tsx src/cli.ts publish",
    "digest": "tsx src/cli.ts digest",
    "prune": "tsx src/cli.ts prune",
    "deliver": "tsx src/cli.ts deliver",
    "serve": "tsx src/cli.ts serve",
    "test": "vitest run",
    "enrich:cldr": "tsx src/cli.ts enrich-cldr"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "cfb": "^1.2.2",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
