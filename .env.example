DATABASE_URL=postgres://postgres:postgres@localhost:5432/countryinfo
PORT=3000
# Required to create/delete webhook subscriptions
ADMIN_TOKEN=change-me
# Where `export` writes files; served under /files
EXPORT_DIR=out
CACHE_DIR=.cache
# Ingest admin2 (counties/districts, ~45k rows) in addition to countries and admin1
INGEST_ADMIN2=true
