# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
ADMIN_TOKEN=change-me-long-random
# Require an API key on /v1/* (keys are created with POST /v1/api-keys using the admin token)
REQUIRE_API_KEY=true
RATE_LIMIT_PER_MIN=600
PUBLIC_BASE_URL=https://api.example.com
FILE_SIGNING_SECRET=change-me-long-random
# Alerts (Slack/Teams-compatible incoming webhook) and release e-mails (JSON webhook, see docs/OPERATIONS.md)
NOTIFY_WEBHOOK_URL=
MAIL_WEBHOOK_URL=
MAIL_FROM=releases@example.com
# File bundles: fs (default, PUBLISH_DIR volume) or s3
PUBLISH_STORE=fs
# S3_ENDPOINT= S3_BUCKET= S3_REGION= S3_ACCESS_KEY= S3_SECRET_KEY=
# Optional: CYCLE_AT=03:17 (UTC), DISABLE_SOURCES=gisco-lau
